# Anthropic API key - get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use (latest recommended)
CLAUDE_MODEL=claude-opus-4-5

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Infra track settings ---
# How many recent agent calls to keep in the evaluation window
EVAL_WINDOW_SIZE=20

# Guardrail: max output tokens per agent response
GUARDRAIL_MAX_TOKENS=4096

# Guardrail: minimum safety score (0.0–1.0) before a response is passed through
GUARDRAIL_MIN_SAFETY_SCORE=0.7

# --- Gaming track settings ---
# Tick rate for the game state simulator (ms)
GAME_TICK_MS=100

# Max number of active NPCs per scene
MAX_NPCS=50
